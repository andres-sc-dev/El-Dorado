# Servidor o instancia donde está ejecutándose SQL Server.
DB_SERVER=localhost
# Nombre de la base de datos que contiene las tablas de El Dorado.
DB_DATABASE=el_dorado
# Usuario de SQL Server. Déjalo vacío si usarás autenticación de Windows.
DB_USER=
# Contraseña del usuario de SQL Server.
DB_PASSWORD=
# Puerto TCP de SQL Server; el valor habitual es 1433.
DB_PORT=1433
# Clave privada usada para firmar los tokens JWT. Usa una cadena larga y secreta.
JWT_SECRET=
# Orígenes permitidos separados por coma.
CORS_ORIGINS=http://localhost:5173
# Cookie de sesión: en desarrollo debe ser false; en HTTPS debe ser true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Puerto HTTP donde escuchará Express.
PORT=4000
