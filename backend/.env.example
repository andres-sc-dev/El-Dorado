# El Dorado · variables de entorno.
# Copia este archivo como .env (en la raíz) y llena los valores. El .env nunca va a Git.
# docker compose lee el .env de la raíz. Para correr el backend sin Docker, usa backend/.env.

# ---------- Sesión ----------
# Cadena larga y aleatoria (mínimo 32 caracteres).
JWT_SECRET=

# ---------- SQL Server (identidad) ----------
# La contraseña de sa y la del login de la app deben cumplir la política de SQL Server:
# 8+ caracteres con mayúsculas, minúsculas, números y símbolos. No uses comillas.
MSSQL_SA_PASSWORD=
SQLSERVER_USER=
SQLSERVER_PASSWORD=
# Solo para correr el backend fuera de Docker:
SQLSERVER_HOST=
SQLSERVER_PORT=
SQLSERVER_DB=

# ---------- MySQL (competición y cuotas) ----------
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=
# Solo para correr el backend fuera de Docker:
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=

# ---------- PostgreSQL (dinero y equipos) ----------
POSTGRES_USER=
POSTGRES_PASSWORD=
# Solo para correr el backend fuera de Docker:
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=

# ---------- MongoDB (mercados, reglas y auditoría) ----------
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
# Solo para correr el backend fuera de Docker (en Docker se arma solo):
MONGO_URI=
MONGO_DB=

# ---------- Usuario de demostración (lo crea npm run seed:demo) ----------
# Obligatorios:
DEMO_USERNAME=
DEMO_PASSWORD=
# Opcionales:
DEMO_EMAIL=
DEMO_FULL_NAME=
DEMO_DOCUMENT=
DEMO_BALANCE=

# ---------- Administrador (lo crea npm run seed:demo con rol ADM) ----------
# El registro público siempre crea usuarios USR; el único ADM sale de aquí.
# ADMIN_PASSWORD: mínimo 12 caracteres. ADMIN_DOCUMENT: cédula de 6 a 10 dígitos.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DOCUMENT=

# ---------- Límites de apuesta en COP ----------
# La API y fn_crear_apuesta los aplican. El CHECK de la tabla bet tiene un tope duro
# de 1.000 a 500.000: si los amplías, cambia también ck_bet_stake_limits.
BET_MIN_COP=1000
BET_MAX_COP=500000

# ---------- Wompi Sandbox (recargas) ----------
# Cuenta gratuita en comercios.wompi.co -> modo Sandbox -> "Desarrolladores".
# SOLO llaves de Sandbox: pub_test_..., prv_test_..., test_events_..., test_integrity_...
# Con llaves de producción (pub_prod_...) la API bloquea los pagos (503 PAYMENTS_NOT_CONFIGURED).
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_MIN_COP=10000
WOMPI_MAX_COP=3000000
# La misma llave pública, para el Widget del frontend.
VITE_WOMPI_PUBLIC_KEY=

# ---------- Firebase (Firestore guarda cada recarga en la colección payments) ----------
# Consola de Firebase -> Configuración del proyecto -> Cuentas de servicio -> Generar clave privada.
# Copia los tres valores del JSON aquí; el JSON NUNCA va a Git.
# FIREBASE_PRIVATE_KEY entre comillas, con los saltos de línea escritos como 
.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------- Puertos del equipo anfitrión (opcionales) ----------
SQLSERVER_HOST_PORT=
MYSQL_HOST_PORT=
POSTGRES_HOST_PORT=
MONGO_HOST_PORT=
BACKEND_HOST_PORT=
FRONTEND_HOST_PORT=

# ---------- Backend fuera de Docker (opcionales) ----------
PORT=
CORS_ORIGINS=
COOKIE_SECURE=
COOKIE_SAMESITE=
